        <Tab Title="🏢 Fornecedores">
            <ShellContent x:Name="abaFornecedores" Route="FornecedorPage" />
        </Tab>
        <Tab Title="📁 Categorias">
            <ShellContent x:Name="abaCategorias" Route="CategoriaPage" />
        </Tab>
    </TabBar>

</Shell>
