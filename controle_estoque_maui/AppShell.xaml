    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.FlyoutBehavior="Disabled"
    Title="Tech Stock Pro">

    <TabBar>
        <Tab Title="📦 Estoque">
            <ShellContent x:Name="abaEstoque" Route="EstoquePage" />
